-- Slider row
local function makeSlider(parent, y, labelText, minVal, maxVal, valueKey, callback, isDecimal)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, 0, 0, 42)
    row.Position = UDim2.new(0, 0, 0, y)
    row.BackgroundColor3 = Color3.fromRGB(18, 0, 0)
    row.BorderSizePixel = 0
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 9)

    local lbl = Instance.new("TextLabel", row)
    lbl.Size = UDim2.new(0.58, 0, 0, 18)
    lbl.Position = UDim2.new(0, 10, 0, 3)
    lbl.BackgroundTransparency = 1
    lbl.Text = labelText
    lbl.TextColor3 = Color3.fromRGB(200, 120, 120)
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local defVal = Values[valueKey]

    local valBox = Instance.new("TextBox", row)
    valBox.Size = UDim2.new(0, 46, 0, 18)
    valBox.Position = UDim2.new(1, -52, 0, 3)
    valBox.BackgroundColor3 = Color3.fromRGB(30, 5, 5)
    valBox.Text = isDecimal and string.format("%.1f", defVal) or tostring(defVal)
    valBox.TextColor3 = Color3.fromRGB(255, 180, 180)
    valBox.Font = Enum.Font.GothamBold
    valBox.TextSize = 12
    valBox.ClearTextOnFocus = false
    Instance.new("UICorner", valBox).CornerRadius = UDim.new(0, 5)

    local trackBg = Instance.new("Frame", row)
    trackBg.Size = UDim2.new(0.9, 0, 0, 7)
    trackBg.Position = UDim2.new(0.05, 0, 0, 28)
    trackBg.BackgroundColor3 = Color3.fromRGB(35, 5, 5)
    trackBg.ZIndex = 2
    Instance.new("UICorner", trackBg).CornerRadius = UDim.new(1, 0)

    local pct = (defVal - minVal) / (maxVal - minVal)
    local fill = Instance.new("Frame", trackBg)
    fill.Size = UDim2.new(pct, 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
    fill.ZIndex = 3
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local thumb = Instance.new("Frame", trackBg)
    thumb.Size = UDim2.new(0, 13, 0, 13)
    thumb.Position = UDim2.new(pct, -6, 0.5, -6)
    thumb.BackgroundColor3 = Color3.new(1,1,1)
    thumb.ZIndex = 4
    Instance.new("UICorner", thumb).CornerRadius = UDim.new(1, 0)

    local sliderBtn = Instance.new("TextButton", trackBg)
    sliderBtn.Size = UDim2.new(1, 0, 4, 0)
    sliderBtn.Position = UDim2.new(0, 0, -1.5, 0)
    sliderBtn.BackgroundTransparency = 1
    sliderBtn.Text = ""
    sliderBtn.ZIndex = 5

    local function roundVal(v)
        return isDecimal and (math.floor(v*10+0.5)/10) or math.floor(v+0.5)
    end

    SliderSetters[valueKey] = function(val)
        val = math.clamp(val, minVal, maxVal)
        local r = (val - minVal) / (maxVal - minVal)
        fill.Size = UDim2.new(r, 0, 1, 0)
        thumb.Position = UDim2.new(r, -6, 0.5, -6)
        valBox.Text = isDecimal and string.format("%.1f", val) or tostring(val)
        Values[valueKey] = val
    end

    local dragging = false
    local function update(rel)
        rel = math.clamp(rel, 0, 1)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        thumb.Position = UDim2.new(rel, -6, 0.5, -6)
        local val = roundVal(minVal + (maxVal - minVal) * rel)
        valBox.Text = isDecimal and string.format("%.1f", val) or tostring(val)
        Values[valueKey] = val
        callback(val)
    end

    sliderBtn.MouseButton1Down:Connect(function() dragging = true end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            update((i.Position.X - trackBg.AbsolutePosition.X) / trackBg.AbsoluteSize.X)
        end
    end)
    valBox.FocusLost:Connect(function()
        local n = tonumber(valBox.Text)
        if n then
            n = math.clamp(roundVal(n), minVal, maxVal)
            local r = (n - minVal) / (maxVal - minVal)
            fill.Size = UDim2.new(r, 0, 1, 0)
            thumb.Position = UDim2.new(r, -6, 0.5, -6)
            valBox.Text = isDecimal and string.format("%.1f", n) or tostring(n)
            Values[valueKey] = n
            callback(n)
        end
    end)

    return row
end

