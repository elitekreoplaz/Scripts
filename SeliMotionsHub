--// TOP BAR DRAG ONLY
do
    local dragging = false
    local dragStart, startPos

    local function updateDrag(input)
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end

    title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateDrag(input)
        end
    end)
end

--// HELPERS
local function makeToggle(text)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 28)
    frame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    frame.BorderSizePixel = 0

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.6, -6, 1, 0)
    label.Position = UDim2.new(0, 6, 0, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.Code
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Text = text .. ": OFF"
    label.TextSize = 14
    label.TextColor3 = Color3.new(1, 1, 1)
    label.Parent = frame

    local button = Instance.new("TextButton")
    button.Size = UDim2.new(0.3, -6, 0.75, 0)
    button.Position = UDim2.new(0.7, 3, 0.125, 0)
    button.BackgroundColor3 = Color3.fromRGB(80, 0, 0)
    button.BorderSizePixel = 0
    button.Font = Enum.Font.Code
    button.Text = "OFF"
    button.TextSize = 14
    button.TextColor3 = Color3.new(1, 1, 1)
    button.Parent = frame

    local state = false

    local function setState(v)
        state = v
        if state then
            label.Text = text .. ": ON"
            button.Text = "ON"
            button.BackgroundColor3 = Color3.fromRGB(0, 120, 40)
        else
            label.Text = text .. ": OFF"
            button.Text = "OFF"
            button.BackgroundColor3 = Color3.fromRGB(80, 0, 0)
        end
    end

    button.MouseButton1Click:Connect(function()
        setState(not state)
    end)

    frame.LayoutOrder = uiList.AbsoluteContentSize.Y

    return frame, function() return state end, setState
end

local function makeSlider(text, min, max, default)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 40)
    frame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    frame.BorderSizePixel = 0

    local top = Instance.new("TextLabel")
    top.Size = UDim2.new(1, -8, 0, 16)
    top.Position = UDim2.new(0, 4, 0, 0)
    top.BackgroundTransparency = 1
    top.Font = Enum.Font.Code
    top.TextColor3 = Color3.new(1, 1, 1)
    top.TextSize = 14
    top.TextXAlignment = Enum.TextXAlignment.Left
    top.Text = text .. ": " .. tostring(default)
    top.Parent = frame

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, -16, 0, 8)
    bar.Position = UDim2.new(0, 8, 0, 22)
    bar.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
    bar.BorderSizePixel = 0
    bar.Parent = frame

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    fill.Position = UDim2.new(0, 0, 0, 0)
    fill.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
    fill.BorderSizePixel = 0
    fill.Parent = bar

    local dragging = false
    local value = default

    local function setValueFromX(x)
        local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local v = math.floor(min + (max - min) * rel + 0.5)
        value = v
        fill.Size = UDim2.new(rel, 0, 1, 0)
        top.Text = text .. ": " .. tostring(v)
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            setValueFromX(input.Position.X)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            setValueFromX(input.Position.X)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    frame.LayoutOrder = uiList.AbsoluteContentSize.Y

    return frame, function() return value end, function(v)
        v = math.clamp(v, min, max)
        value = v
        local rel = (v - min) / (max - min)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        top.Text = text .. ": " .. tostring(v)
    end
end

