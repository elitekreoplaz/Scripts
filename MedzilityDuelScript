-- AUTO STEAL — runs entirely inside the main heartbeat, no popup
-- ============================================================
local isStealingInternal = false
local stealStartTimeInternal = 0

local function findNearestPrompt()
    local root = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    local bestPrompt, bestDist = nil, math.huge
    for _, plot in ipairs(plots:GetChildren()) do
        local sign = plot:FindFirstChild("PlotSign")
        if sign and sign:FindFirstChild("YourBase") and sign.YourBase:IsA("BillboardGui") and sign.YourBase.Enabled then
            continue
        end
        local podiums = plot:FindFirstChild("AnimalPodiums")
        if not podiums then continue end
        for _, pod in ipairs(podiums:GetChildren()) do
            local base = pod:FindFirstChild("Base")
            local spawn = base and base:FindFirstChild("Spawn")
            if not spawn then continue end
            local dist = (spawn.Position - root.Position).Magnitude
            if dist > Values.STEAL_RADIUS then continue end
            local att = spawn:FindFirstChild("PromptAttachment")
            if not att then continue end
            for _, child in att:GetChildren() do
                if child:IsA("ProximityPrompt") then
                    if dist < bestDist then
                        bestPrompt = child
                        bestDist = dist
                    end
                    break
                end
            end
        end
    end
    return bestPrompt
end

local function trySteal(prompt)
    if isStealingInternal then return end
    if not prompt then return end
    isStealingInternal = true
    stealStartTimeInternal = tick()
    local holdFns, triggerFns = {}, {}
    pcall(function()
        if getconnections then
            for _, c in getconnections(prompt.PromptButtonHoldBegan) do
                if c.Function then table.insert(holdFns, c.Function) end
            end
            for _, c in getconnections(prompt.Triggered) do
                if c.Function then table.insert(triggerFns, c.Function) end
            end
        end
    end)
    for _, f in holdFns do task.spawn(f) end
    task.spawn(function()
        task.wait(Values.STEAL_DURATION)
        for _, f in triggerFns do task.spawn(f) end
        task.delay(0.15, function() isStealingInternal = false end)
    end)
end

RunService.Heartbeat:Connect(function()
    if not Enabled.AutoSteal then return end
    if isStealingInternal then return end
    if not Player.Character or not Player.Character:FindFirstChild("HumanoidRootPart") then return end
    local prompt = findNearestPrompt()
    if prompt then trySteal(prompt) end
end)

local function startAutoSteal() Enabled.AutoSteal = true end
local function stopAutoSteal()
    Enabled.AutoSteal = false
    isStealingInternal = false
end

