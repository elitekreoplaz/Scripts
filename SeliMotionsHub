--// HUB KEYBIND (RightControl)
local hubVisible = true
local hubKey = Enum.KeyCode.RightControl

local function setHubVisible(v)
    hubVisible = v
    main.Visible = v
end

setHubVisible(true)

UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == hubKey then
        setHubVisible(not hubVisible)
    end
end)

--// LOGIC: WALKSPEED
RunService.RenderStepped:Connect(function()
    if humanoid and humanoid.Parent then
        humanoid.WalkSpeed = getWS()
    end
end)

--// LOGIC: NOCLIP
RunService.Stepped:Connect(function()
    if getNoclip() and character then
        for _, v in ipairs(character:GetDescendants()) do
            if v:IsA("BasePart") and v.CanCollide == true then
                v.CanCollide = false
            end
        end
    end
end)

--// LOGIC: FLY
local flyDir = Vector3.new()

UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.W then
        flyDir = flyDir + Vector3.new(0, 0, -1)
    elseif input.KeyCode == Enum.KeyCode.S then
        flyDir = flyDir + Vector3.new(0, 0, 1)
    elseif input.KeyCode == Enum.KeyCode.A then
        flyDir = flyDir + Vector3.new(-1, 0, 0)
    elseif input.KeyCode == Enum.KeyCode.D then
        flyDir = flyDir + Vector3.new(1, 0, 0)
    elseif input.KeyCode == Enum.KeyCode.Space then
        flyDir = flyDir + Vector3.new(0, 1, 0)
    elseif input.KeyCode == Enum.KeyCode.LeftControl then
        flyDir = flyDir + Vector3.new(0, -1, 0)
    end
end)

UIS.InputEnded:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.W then
        flyDir = flyDir - Vector3.new(0, 0, -1)
    elseif input.KeyCode == Enum.KeyCode.S then
        flyDir = flyDir - Vector3.new(0, 0, 1)
    elseif input.KeyCode == Enum.KeyCode.A then
        flyDir = flyDir - Vector3.new(-1, 0, 0)
    elseif input.KeyCode == Enum.KeyCode.D then
        flyDir = flyDir - Vector3.new(1, 0, 0)
    elseif input.KeyCode == Enum.KeyCode.Space then
        flyDir = flyDir - Vector3.new(0, 1, 0)
    elseif input.KeyCode == Enum.KeyCode.LeftControl then
        flyDir = flyDir - Vector3.new(0, -1, 0)
    end
end)

RunService.RenderStepped:Connect(function(dt)
    if not getFly() then
        if humanoid then
            humanoid.PlatformStand = false
        end
        return
    end

    if not (character and hrp and humanoid) then
        return
    end

    humanoid.PlatformStand = true

    local dir = flyDir
    if dir.Magnitude > 0 then
        dir = dir.Unit
        local camCF = workspace.CurrentCamera.CFrame
        local moveVec =
            camCF.RightVector * dir.X +
            camCF.UpVector * dir.Y +
            -camCF.LookVector * dir.Z

        hrp.Velocity = moveVec.Unit * getFS()
    else
        hrp.Velocity = Vector3.new(0, 0, 0)
    end
end)

--// LOGIC: INFINITE JUMP
local infJumpConnection

local function enableInfJump()
    if infJumpConnection then infJumpConnection:Disconnect() end
    local m = lp:GetMouse()
    infJumpConnection = m.KeyDown:Connect(function(k)
        if getInfJump() and k:byte() == 32 then -- Space
            if lp.Character and lp.Character:FindFirstChildOfClass("Humanoid") then
                local h = lp.Character:FindFirstChildOfClass("Humanoid")
                h:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
    end)
end

enableInfJump()

--// LOGIC: ESP (Highlight on other players)
local highlights = {}

local function clearESP()
    for plr, h in pairs(highlights) do
        if h and h.Parent then
            h:Destroy()
        end
    end
    highlights = {}
end

local function applyESPToCharacter(plr, char)
    if plr == lp then return end
    if not char then return end

    local existing = highlights[plr]
    if existing and existing.Parent then
        existing:Destroy()
    end

    local highlight = Instance.new("Highlight")
    highlight.Adornee = char
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillTransparency = 0.8
    highlight.OutlineTransparency = 0
    highlight.OutlineColor = Color3.fromRGB(255, 255, 0)
    highlight.FillColor = Color3.fromRGB(255, 0, 0)
    highlight.Parent = char

    highlights[plr] = highlight
end

local function refreshESP()
    if not getESP() then
        clearESP()
        return
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= lp then
            local char = plr.Character
            if char then
                applyESPToCharacter(plr, char)
            end
        end
    end
end

Players.PlayerAdded:Connect(function(plr)
    plr.CharacterAdded:Connect(function(char)
        task.wait(1)
        if getESP() then
            applyESPToCharacter(plr, char)
        end
    end)
end)

Players.PlayerRemoving:Connect(function(plr)
    local h = highlights[plr]
    if h and h.Parent then
        h:Destroy()
    end
    highlights[plr] = nil
end)

-- keep ESP in sync with toggle
setESP(false)
setFly(false)
setNoclip(false)
setInfJump(false)

RunService.RenderStepped:Connect(function()
    if getESP() then
        refreshESP()
    else
        clearESP()
    end
end)
