--// WHITELIST CHECK
local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer

-- Only this UserId is allowed (EliteKreoPlaz)
local WHITELISTED_USER_IDS = {
    [8155092270] = true,
}

local function isWhitelisted(player)
    return WHITELISTED_USER_IDS[player.UserId] == true
end

if not isWhitelisted(localPlayer) then
    localPlayer:Kick("This User Is Not Currently Whitelisted")
    return -- stop the rest of the script from running
end
--// END WHITELIST CHECK

